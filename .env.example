# Discord bot token (Developer Portal) / Token del bot
DISCORD_TOKEN=your_bot_token_here

# SQLite path (relative to project root) / Ruta SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/spam_detector.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Purge rows older than N days on DB init (0 = disabled) / Retención (0 = off)
# DATA_RETENTION_DAYS=90

# Optional ML — see ML.md / ML opcional — ver ML.md
# ML_ENABLED=false
# ML_MODEL_PATH=data/models/ml_bundle.joblib
# ML_HYBRID_ENABLED=true
# ML_SCORE_BOOST_MAX=20
# ML_ALERT_SPAM_THRESHOLD=0.85
# ML_ALERT_AUTOMATION_THRESHOLD=0.85
# ML_HYBRID_MIN_DUPLICATE_RATIO=0.25

# Moderation defaults — see MODERATION.md / Moderación — ver MODERATION.md
# MODERATION_ENABLED=false
# MODERATION_DRY_RUN=true
# MODERATION_COOLDOWN_SECONDS=300
# MODERATION_PENALIZE_SPAM=true
# MODERATION_PENALIZE_AUTOMATION=false
# MODERATION_MIN_SPAM_SCORE=40
# MODERATION_MIN_AUTOMATION_SCORE=40
# MODERATION_TIMEOUT_SUSPICIOUS=600
# MODERATION_TIMEOUT_SPAM_LIKELY=3600
# MODERATION_TIMEOUT_AUTOMATION_SUSPICIOUS=0
# MODERATION_TIMEOUT_AUTOMATION_LIKELY=0

# Optional: only this channel accepts !mod / Solo este canal acepta !mod
# MOD_CONFIG_CHANNEL_ID=1234567890123456789

# Alert embed channel(s): guild_id:channel_id or channel_id only / Canal de alertas
# ALERT_CHANNELS=1552990330947768410:1553016584619040878
# ALERT_CHANNELS=1553016584619040878
